      {
        "name": "Claims",
        "columns": [
          {
            "name": "ClaimFactKey(FactClaim)",
            "dataType": "int64",
            "sourceColumn": "ClaimFactKey",
            "sourceProviderType": "BigInt"
          },
          {
            "name": "ClaimID(FactClaim)",
            "dataType": "int64",
            "sourceColumn": "ClaimID",
            "sourceProviderType": "Integer"
          },
          {
            "name": "PatientKey(FactClaim)",
            "dataType": "int64",
            "sourceColumn": "PatientKey",
            "sourceProviderType": "Integer"
          },
          {
            "name": "PolicyKey(FactClaim)",
            "dataType": "int64",
            "sourceColumn": "PolicyKey",
            "sourceProviderType": "Integer"
          },
          {
            "name": "ProviderKey(FactClaim)",
            "dataType": "int64",
            "sourceColumn": "ProviderKey",
            "sourceProviderType": "Integer"
          },
          {
            "name": "DiagnosisKey(FactClaim)",
            "dataType": "int64",
            "sourceColumn": "DiagnosisKey",
            "sourceProviderType": "Integer"
          },
          {
            "name": "ClaimDateKey(FactClaim)",
            "dataType": "int64",
            "sourceColumn": "ClaimDateKey",
            "sourceProviderType": "Integer"
          },
          {
            "name": "AdmissionDateKey(FactClaim)",
            "dataType": "int64",
            "sourceColumn": "AdmissionDateKey",
            "sourceProviderType": "Integer"
          },
          {
            "name": "DischargeDateKey(FactClaim)",
            "dataType": "int64",
            "sourceColumn": "DischargeDateKey",
            "sourceProviderType": "Integer"
          },
          {
            "name": "ClaimedAmount(FactClaim)",
            "dataType": "double",
            "sourceColumn": "ClaimedAmount",
            "sourceProviderType": "Numeric"
          },
          {
            "name": "ApprovedAmount(FactClaim)",
            "dataType": "double",
            "sourceColumn": "ApprovedAmount",
            "sourceProviderType": "Numeric"
          },
          {
            "name": "RejectedAmount(FactClaim)",
            "dataType": "double",
            "sourceColumn": "RejectedAmount",
            "sourceProviderType": "Numeric"
          },
          {
            "name": "OutOfPocketAmount(FactClaim)",
            "dataType": "double",
            "sourceColumn": "OutOfPocketAmount",
            "sourceProviderType": "Numeric"
          },
          {
            "name": "LengthOfStay(FactClaim)",
            "dataType": "int64",
            "sourceColumn": "LengthOfStay",
            "sourceProviderType": "Integer"
          },
          {
            "name": "ClaimStatus(FactClaim)",
            "dataType": "string",
            "sourceColumn": "ClaimStatus",
            "sourceProviderType": "Char"
          },
          {
            "name": "ClaimCount(FactClaim)",
            "dataType": "int64",
            "sourceColumn": "ClaimCount",
            "sourceProviderType": "Integer"
          },
          {
            "type": "calculated",
            "name": "PolicyCoverage",
            "dataType": "double",
            "isDataTypeInferred": true,
            "expression": "Related(Policy[CoverageAmount(DimPolicy)])"
          }
        ],
        "partitions": [
          {
            "name": "vw_FactClaim",
            "dataView": "full",
            "source": {
              "type": "query",
              "query": " \t\t\t\tSELECT [rcore].[vw_FactClaim].*   FROM [rcore].[vw_FactClaim] ",
              "dataSource": "DataMart DB"
            }
          }
        ],
        "measures": [
          {
            "name": "Total Claims",
            "expression": "[Policy Utilization %]"
          },
          {
            "name": "Total Claimed Amount",
            "expression": "SUM(Claims[ClaimedAmount(FactClaim)])",
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\" Accuracy=\"2\"><Currency LCID=\"1033\" DisplayName=\"$ English (United States)\" Symbol=\"$\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          },
          {
            "name": "Total Approved Amount",
            "expression": "SUM(Claims[ApprovedAmount(FactClaim)])",
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\" Accuracy=\"2\"><Currency LCID=\"1033\" DisplayName=\"$ English (United States)\" Symbol=\"$\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          },
          {
            "name": "Total Rejected Amount",
            "expression": "SUM(Claims[RejectedAmount(FactClaim)])",
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\" Accuracy=\"2\"><Currency LCID=\"1033\" DisplayName=\"$ English (United States)\" Symbol=\"$\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          },
          {
            "name": "Approval Rate%",
            "expression": "DIVIDE([Approved Claims],[Total Claims])",
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "Approved Claims",
            "expression": "CALCULATE([Total Claims],Claims[ClaimStatus(FactClaim)] = \"Approved\")"
          },
          {
            "name": "Rejected Claims",
            "expression": "CALCULATE([Total Claims],Claims[ClaimStatus(FactClaim)] = \"Rejected\")"
          },
          {
            "name": "DistinctPatients",
            "expression": "DISTINCTCOUNT(Patient[PatientID(DimPatient)])"
          },
          {
            "name": "Average Length of Stay",
            "expression": "Average(Claims[LengthOfStay(FactClaim)])"
          },
          {
            "name": "Total Out Of Pocket",
            "expression": "SUM(Claims[OutOfPocketAmount(FactClaim)])",
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\" Accuracy=\"2\"><Currency LCID=\"1033\" DisplayName=\"$ English (United States)\" Symbol=\"$\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          },
          {
            "name": "Average Claim Cost",
            "expression": "AVERAGE(Claims[ApprovedAmount(FactClaim)])",
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\" Accuracy=\"2\"><Currency LCID=\"1033\" DisplayName=\"$ English (United States)\" Symbol=\"$\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          },
          {
            "name": "Cost Per Claim",
            "expression": "DIVIDE([Total Approved Amount],[Total Claims])",
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\" Accuracy=\"2\"><Currency LCID=\"1033\" DisplayName=\"$ English (United States)\" Symbol=\"$\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          },
          {
            "name": "Total Policy Coverage",
            "expression": "SUM(Claims[PolicyCoverage])",
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\" Accuracy=\"2\"><Currency LCID=\"1033\" DisplayName=\"$ English (United States)\" Symbol=\"$\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          },
          {
            "name": "Policy Utilization %",
            "expression": "DIVIDE([Total Approved Amount],[Total Policy Coverage])",
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "Remaining Coverage",
            "expression": "[Total Policy Coverage]-[Total Approved Amount]",
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\" Accuracy=\"2\"><Currency LCID=\"1033\" DisplayName=\"$ English (United States)\" Symbol=\"$\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          },
          {
            "name": "Average Claims Per Patient",
            "expression": "Divide([Total Claims],[DistinctPatients])"
          },
          {
            "name": "Approved Amount Last 90 Days",
            "expression": [
              "CALCULATE(",
              "    [Total Approved Amount],",
              "    DATESINPERIOD(",
              "       DateMaster[FullDate(DimDate)],",
              "        MAX(DateMaster[FullDate(DimDate)]),",
              "        -90,",
              "        DAY",
              "    )",
              ")"
            ],
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\" Accuracy=\"2\"><Currency LCID=\"1033\" DisplayName=\"$ English (United States)\" Symbol=\"$\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          },
          {
            "name": "YOY Growth",
            "expression": [
              "DIVIDE(",
              "    [Total Approved Amount]",
              "    -",
              "    [Previous Year Approved Amount],",
              "    [Previous Year Approved Amount]",
              ")"
            ],
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "Running Total",
            "expression": [
              "CALCULATE(",
              "    [Total Approved Amount],",
              "    FILTER(",
              "        ALL(DateMaster),",
              "        DateMaster[FullDate(DimDate)]",
              "<= MAX(DateMaster[FullDate(DimDate)])",
              "    )",
              ")"
            ],
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\" Accuracy=\"2\"><Currency LCID=\"1033\" DisplayName=\"$ English (United States)\" Symbol=\"$\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          },
          {
            "name": "Claim Count YTD",
            "expression": [
              "TOTALYTD([Total Claims],DateMaster[FullDate(DimDate)])",
              " "
            ],
            "formatString": "0"
          },
          {
            "name": "Claims Count Last 30 Days",
            "expression": [
              "CALCULATE(",
              "    [Total Claims],",
              "    DATESINPERIOD(",
              "        DateMaster[FullDate(DimDate)],",
              "        MAX(DateMaster[FullDate(DimDate)]),",
              "        -30,",
              "        DAY",
              "    )",
              ")"
            ],
            "formatString": "0"
          },
          {
            "name": "Previous Month Approved Amount",
            "expression": [
              "CALCULATE(",
              "    [Total Approved Amount],",
              "    PREVIOUSMONTH(DateMaster[FullDate(DimDate)])",
              ")"
            ],
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\" Accuracy=\"2\"><Currency LCID=\"1033\" DisplayName=\"$ English (United States)\" Symbol=\"$\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          },
          {
            "name": "Previous Year Approved Amount",
            "expression": [
              "CALCULATE(",
              "    [Total Approved Amount],",
              "    SAMEPERIODLASTYEAR(DateMaster[FullDate(DimDate)])",
              ")"
            ],
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\" Accuracy=\"2\"><Currency LCID=\"1033\" DisplayName=\"$ English (United States)\" Symbol=\"$\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          }
        ],
        "annotations": [
          {
            "name": "_TM_ExtProp_QueryDefinition",
            "value": " \t\t\t\tSELECT [rcore].[vw_FactClaim].*   FROM [rcore].[vw_FactClaim] "
          },
